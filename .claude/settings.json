{
  "permissions": {
    "deny": [
      "Bash(aws:*)",
      "Bash(cdk deploy:*)",
      "Bash(cdk bootstrap:*)",
      "Bash(cdk diff:*)",
      "Bash(cdk destroy:*)",
      "Bash(gh workflow:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh api:*pending_deployments*)",
      "Bash(gh api:*environments*)",
      "Bash(*break-glass.sh*)",
      "Bash(npx cdk deploy:*)",
      "Bash(npx cdk bootstrap:*)",
      "Bash(npx cdk diff:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(npx aws-cdk deploy:*)",
      "Bash(npx aws-cdk bootstrap:*)",
      "Bash(npx aws-cdk diff:*)",
      "Bash(npx aws-cdk destroy:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh run delete:*)",
      "Bash(gh api:*deployments*)",
      "Bash(gh api:*Deployment*)",
      "Bash(gh api:*Environment*)",
      "Bash(gh api:*dispatches*)",
      "Bash(gh api:*/rerun*)",
      "Bash(gh api:*cancel*)",
      "Bash(gh api:*actions/workflows*)",
      "Bash(gh api:*actions/runs*)",
      "Bash(gh api:*secrets*)",
      "Bash(gh api:*variables*)",
      "Bash(gh api:*oidc*)",
      "Bash(gh api:*rulesets*)",
      "Bash(gh api:*actions/permissions*)",
      "Bash(*protect-environments.sh apply*)",
      "Bash(*protect-main.sh*)",
      "mcp__github__actions_run_trigger",
      "mcp__claude-in-chrome",
      "mcp__Claude_Browser",
      "mcp__computer-use",
      "mcp__remote-devices"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-push.sh",
            "timeout": 120,
            "statusMessage": "Committing and pushing to GitHub..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "JohnnyVizz/claude-kit"
      }
    }
  },
  "enabledPlugins": {
    "savvy-flow@claude-kit": true,
    "savvy-progress@claude-kit": true
  }
}
