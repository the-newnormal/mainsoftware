# The landing-zone entry's configuration (C11-D25; infra/src/config/env.ts; TECH-SPEC T24 item 10).
# Only bin/landing-zone.ts reads these, and only on a person's own machine: the workload entry and
# the deploy pipeline never do. They identify the organisation, its accounts and its people's groups,
# and this repository is public, so they are never committed: copy this file to infra/.env.local
# (git-ignored, as every .env* file but this one is), fill it in there, and never paste it into a
# chat, an issue or a coding agent's session. Every value here is left empty on purpose.
#
# Synthesise in a shell with no AWS credentials, from infra/:
#   HEARTH_TARGET=foundation npx cdk synth --app "node --env-file=.env.local bin/landing-zone.ts" --no-lookups
# read the diff and the asset check, then deploy only the synthesised assembly from the credentialed
# shell (`cdk deploy --app cdk.out`), as docs/runbooks/aws-account-set-up.md says.
# A problem names its variable and what it must be, never the value.

# --- The run ----------------------------------------------------------------------------------------

# Which stacks this run builds, one at a time, each deployed into its own account under its own
# credentials: foundation (management), log-archive, nonprod-baseline or prod-baseline. A real run
# refuses `all`, the fixture's, and refuses the committed .invalid domains until the owner chooses
# them (C11-Q08).
HEARTH_TARGET=
# 1 builds every target from the made-up fixture (src/testing/fixture.ts), as CI's synth:lz does. A
# fixture run refuses every variable below, so a real value never mixes with a made-up one. Leave it
# unset for a real run.
HEARTH_FIXTURE=

# --- The organisation (AWS Organizations) ------------------------------------------------------------

# The organization's id: o- and 10 to 32 lower-case letters and digits.
HEARTH_ORG_ID=
# The organization's root id: r- and 4 to 32 lower-case letters and digits.
HEARTH_ORG_ROOT_ID=
# The three organisational units' ids (ou-…), each its own: Security (log-archive), Workloads
# (nonprod and prod) and Recovery (empty; tier 2 only), C11-D01.
HEARTH_OU_SECURITY=
HEARTH_OU_WORKLOADS=
HEARTH_OU_RECOVERY=

# --- The four accounts (C11-D01) --------------------------------------------------------------------

# Each a 12-digit AWS account id, each its own.
HEARTH_ACCOUNT_MANAGEMENT=
HEARTH_ACCOUNT_LOG_ARCHIVE=
HEARTH_ACCOUNT_NONPROD=
HEARTH_ACCOUNT_PROD=

# --- Identity Center (C11-D09, C11-D10) -------------------------------------------------------------

# The organisation instance's id (ssoins- and 16 hex digits). Its ARN is formed at synth from this id,
# so no ARN is ever written down.
HEARTH_SSO_INSTANCE_ID=
# The built-in identity store's id: d- and 10 hex digits.
HEARTH_IDENTITY_STORE_ID=
# The groups the permission sets are assigned to, each the identity store's group id (a UUID,
# sometimes after 10 hex digits and a hyphen), each its own. People join them by hand, because names
# are personal data: hearth-org-admins (HearthOrgAdmin), hearth-on-call (HearthBreakGlassEntry),
# hearth-nonprod-operators (HearthNonprodOperator), hearth-reviewers (HearthSecurityReview) and
# hearth-billing (HearthBilling).
HEARTH_GROUP_ORG_ADMINS=
HEARTH_GROUP_ON_CALL=
HEARTH_GROUP_NONPROD_OPERATORS=
HEARTH_GROUP_REVIEWERS=
HEARTH_GROUP_BILLING=

# --- GitHub's OIDC trust (C11-D55) ------------------------------------------------------------------

# The repository whose deploy workflow the OIDC roles trust, as owner/name.
HEARTH_GITHUB_REPOSITORY=
# GitHub's numeric ids of its owner and of the repository (`gh api repos/{owner}/{repo}` reads both).
HEARTH_GITHUB_OWNER_ID=
HEARTH_GITHUB_REPOSITORY_ID=
# The OIDC subject each trust compares exactly (StringEquals), read back by a repo admin from the
# repository's subject customisation, which includes job_workflow_ref. It starts repo: and the
# repository above (owner/name, or owner@id/name@id from the two ids), names {environment} exactly
# once and, as job_workflow_ref, that repository's deploy workflow on main
# (.github/workflows/deploy.yml@refs/heads/main), holds no * or ?, and may use the placeholders
# {owner}, {name}, {repository}, {ownerId} and {repositoryId}.
HEARTH_GITHUB_SUBJECT_FORMAT=

# --- Alerts and budgets -----------------------------------------------------------------------------

# The ops role mailbox every alarm and budget emails (C11-D16, C11-Q07): a role address reaching the
# person on call, the second reviewer and the DPO, never a person's own. Email only, never SMS.
HEARTH_ALERT_EMAIL=
# Monthly budgets in whole US dollars (C11-D20, C11-Q09), alerting at 80 % and 100 % of actual and
# 100 % of forecast: the organisation's, then each account's. C11-Q09 (31 Oct 2026): organisation 650,
# prod 350, non-prod 250, management 25, log-archive 25, so the 80 % actual-spend alert sits above
# each environment's expected spend.
HEARTH_BUDGET_ORGANISATION_USD=
HEARTH_BUDGET_MANAGEMENT_USD=
HEARTH_BUDGET_LOG_ARCHIVE_USD=
HEARTH_BUDGET_NONPROD_USD=
HEARTH_BUDGET_PROD_USD=
